{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "regions": ["gru1"],
    "installCommand": "echo \"sem dependencias de frontend\"",
    "buildCommand": "rm -rf .vercel-static && mkdir -p .vercel-static && cp -r public/. .vercel-static/ && rm -f .vercel-static/index.php .vercel-static/.htaccess",
    "outputDirectory": ".vercel-static",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 60
        }
    },
    "redirects": [
        {
            "source": "/index.php",
            "destination": "/",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_LOCALE": "pt_BR",
        "APP_FALLBACK_LOCALE": "pt_BR",
        "APP_FAKER_LOCALE": "pt_BR",
        "APP_TIMEZONE": "America/Sao_Paulo",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "error",
        "DB_CONNECTION": "pgsql",
        "DB_PORT": "5432",
        "DB_SSLMODE": "require",
        "DB_EMULATE_PREPARES": "true",
        "SESSION_DRIVER": "database",
        "SESSION_LIFETIME": "480",
        "CACHE_STORE": "database",
        "QUEUE_CONNECTION": "sync",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views"
    }
}
