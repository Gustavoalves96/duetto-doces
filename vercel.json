{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "memory": 1024,
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "src": "/css/(.*)",
            "dest": "/public/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/public/js/$1"
        },
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/public/images/$1"
        },
        {
            "src": "/fonts/(.*)",
            "dest": "/public/fonts/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_LOCALE": "pt_BR",
        "APP_FALLBACK_LOCALE": "pt_BR",
        "APP_FAKER_LOCALE": "pt_BR",
        "APP_TIMEZONE": "America/Sao_Paulo",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "error",
        "DB_CONNECTION": "pgsql",
        "DB_PORT": "5432",
        "DB_SSLMODE": "require",
        "SESSION_DRIVER": "database",
        "SESSION_LIFETIME": "480",
        "CACHE_STORE": "database",
        "QUEUE_CONNECTION": "sync",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "DB_EMULATE_PREPARES": "true"
    },
    "build": {
        "env": {
            "APP_ENV": "production",
            "APP_LOCALE": "pt_BR",
            "VIEW_COMPILED_PATH": "/tmp/storage/framework/views"
        }
    }
}
